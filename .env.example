# Copy this file to .env.local and fill in real values.
# In Vercel: Project Settings → Environment Variables (add the same ones there for production).

# ---- Supabase (required) ----
# Find these in your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Stripe (optional — leave blank and the app runs fine without payments) ----
# Find these in your Stripe dashboard: Developers → API keys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# After you create a webhook (see SETUP.md), Stripe gives you this:
STRIPE_WEBHOOK_SECRET=

# Create two recurring Prices in Stripe (Product catalog → Add product → Recurring),
# one for each membership tier, then paste their Price IDs here:
STRIPE_PRICE_CIRCLE=
STRIPE_PRICE_INNER_CIRCLE=

# Optional: days of free trial on a new membership (leave blank for none).
STRIPE_TRIAL_DAYS=

# ---- Site URL (used in emails/redirects) ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- OneSignal (optional — leave blank and the app runs fine without push) ----
# Find this in OneSignal: Settings → Keys & IDs
NEXT_PUBLIC_ONESIGNAL_APP_ID=
# The REST API Key from the same page is a secret — only add it directly in
# Vercel's environment variables, never paste it into chat or commit it here.
ONESIGNAL_REST_API_KEY=

# Secret that authorizes Vercel Cron to hit /api/cron/* routes. Generate any
# random string and add it in both Vercel env vars and Vercel's Cron settings
# won't need it manually — Vercel sends it automatically as a Bearer header
# once this env var exists.
CRON_SECRET=

# ---- Square (payments) ----
# Square Developer dashboard -> your application -> Credentials
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# 'sandbox' while testing, 'production' when live
SQUARE_ENVIRONMENT=production
# Developer dashboard -> Webhooks -> signature key
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Must exactly match the URL registered in Square's webhook settings
SQUARE_WEBHOOK_URL=

# Subscription plan VARIATION ids (not the plan id — Square subscribes buyers
# to a variation). Create the plan and its variations in Square, then paste.
SQUARE_PLAN_MONTHLY=
SQUARE_PLAN_ANNUAL=

# Prices in cents. Must match the variation prices in Square, or Square
# treats the difference as a price override.
SQUARE_PRICE_MONTHLY=2900
SQUARE_PRICE_ANNUAL=29000
SQUARE_PRICE_CALL=19800
